<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.com.brorder.menu.Menu">

    <!-- 특정 가게의 전체 메뉴 목록 조회 -->
    <select id="selectMenuListByStoreId" parameterType="java.lang.Integer" resultType="kr.com.brorder.menu.Menu">
        SELECT
            menu_id AS menuId,
            store_id AS storeId,
            name,
            content,
            picture,
            price
        FROM
            menu
        WHERE
            store_id = #{storeId} <!-- 전달받은 가게 ID로 필터링 -->
        ORDER BY
            menu_id DESC <!-- 최근에 등록한 메뉴가 먼저 나오도록 내림차순 정렬 -->
    </select>

    <!-- 메뉴 단건 상세 조회 (수정 폼 등에 사용) -->
    <select id="selectMenuById" parameterType="java.lang.Integer" resultType="kr.com.brorder.menu.Menu">
        SELECT
            menu_id AS menuId,
            store_id AS storeId,
            name,
            content,
            picture,
            price
        FROM
            menu
        WHERE
            menu_id = #{menuId}
    </select>

    <!-- 메뉴 등록 -->
    <insert id="insertMenu" parameterType="kr.com.brorder.menu.Menu">
        INSERT INTO menu (store_id, name, content, picture, price)
        VALUES (#{storeId}, #{name}, #{content}, #{picture}, #{price})
    </insert>

    <!-- 메뉴 수정 -->
    <update id="updateMenu" parameterType="kr.com.brorder.menu.Menu">
        UPDATE menu
        SET name = #{name},
        content = #{content},
        price = #{price}
        <!-- 이미지를 새로 업로드 했을 때만(null이나 빈값이 아닐 때) 사진 정보 업데이트 -->
        <if test="picture != null and picture != ''">
            , picture = #{picture}
        </if>
        WHERE menu_id = #{menuId}
    </update>

    <!-- 메뉴 삭제 -->
    <delete id="deleteMenu" parameterType="java.lang.Integer">
        DELETE FROM menu WHERE menu_id = #{menuId}
    </delete>

</mapper>